{
  // Baseline global multiplier = 1.0 (vanilla, YUNG's, Repurposed Structures, Born in Chaos, AE2 meteorites, and other boss arenas stay at default spacing)
  "spreadFactor": 1.0,

  // Prevents different structure mods from overlapping on the exact same coordinates
  "idBasedSalt": false,

  // Explicit structure set multipliers
  "customSpreadFactors": [
    // --- Bosses'Rise (Block Factory's Bosses - Heavy Spacing) ---
    { "structure": "block_factorys_bosses:dragon_tower", "factor": 4.0 },
    { "structure": "block_factorys_bosses:kraken_ship", "factor": 2.0 },
    { "structure": "block_factorys_bosses:sandworm_nest", "factor": 2.0 },
